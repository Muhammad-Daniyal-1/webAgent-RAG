# ─────────────────────────────────────────
# WebAgent RAG — Backend environment
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────

# LLM provider (Groq) — get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Admin authentication
# The first admin account is seeded from these on startup (only if no admin
# exists yet). After that, manage admins from the dashboard.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_a_secure_password
# JWT signing secret — must be a long random string (>= 32 chars)
ADMIN_SECRET=change-this-to-a-long-random-secret-min-32-chars
# How long an admin login token stays valid (hours)
ADMIN_TOKEN_TTL_HOURS=24

# CORS — comma-separated list of frontend origins allowed to call the API.
# Use * only for local development. For the embeddable widget, list the
# domains where the widget will be hosted.
ALLOWED_ORIGINS=*

# ── Database (optional) ──
# Defaults to local SQLite. For production, point at a hosted Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
# DATABASE_URL=sqlite:///./webagent.db

# ── Session store (optional) ──
# If set, conversation state persists in Redis instead of memory.
# REDIS_URL=redis://default:password@host:6379
# SESSION_TTL_SECONDS=86400

# ── Re-crawl scheduler ──
# How often (minutes) to check whether the site is due for an auto re-crawl.
RECRAWL_CHECK_MINUTES=60
